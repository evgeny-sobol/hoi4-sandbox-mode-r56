# gdd/Scenarios Catalog.md: arc events for ita_med.
# ids sandbox_ita_med.1 (crisis) + N ultimatums covering variant A and B targets.
add_namespace(sandbox_ita_med)

# Crisis: The Mediterranean Empire.
country_event:
  id(sandbox_ita_med.1)
  title(sandbox_ita_med_1_t)
  desc(sandbox_ita_med_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(ITA)
  option:
    name(sandbox_ita_med_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, ita_med_crisis)
    add_war_support(0.05)
  option:
    name(sandbox_ita_med_1_b)
    ai_chance:
      factor(15)
    add_war_support(0.02)
# Ultimatum 2 (TUR | FRA).
country_event:
  id(sandbox_ita_med.2)
  title(sandbox_ita_med_2_t)
  desc(sandbox_ita_med_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(TUR | FRA)
  option:
    name(sandbox_ita_med_2_a)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    ITA:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, ita_med_ult_2_submit)
  option:
    name(sandbox_ita_med_2_b)
    ai_chance:
      factor(30)
    add_war_support(-0.05)
    $sandbox_log_sc(sc_crisis, ita_med_ult_2_defy)
# Ultimatum 3 (ROM | ENG).
country_event:
  id(sandbox_ita_med.3)
  title(sandbox_ita_med_3_t)
  desc(sandbox_ita_med_3_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(ROM | ENG)
  option:
    name(sandbox_ita_med_3_a)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    ITA:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, ita_med_ult_3_submit)
  option:
    name(sandbox_ita_med_3_b)
    ai_chance:
      factor(30)
    add_war_support(-0.05)
    $sandbox_log_sc(sc_crisis, ita_med_ult_3_defy)