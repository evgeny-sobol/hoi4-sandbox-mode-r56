# gdd/Scenarios.md "Arc 1: Axis expansion": crisis events. Fired from
# sandbox_scenario_tick phase transitions, same tick (triggered-only).
# ids sandbox_axis.1-4. AI options carry the design; players choose freely.
# Every event carries a scope lock (tag or outsider trigger): delayed or
# drifted fires fizzle instead of executing in the wrong country.
# Event ids are namespace-qualified: vanilla rejects dotted ids without it.
add_namespace(sandbox_axis)

# Crises phase: Sudeten unrest lands on the desk in Berlin.
country_event:
  id(sandbox_axis.1)
  title(sandbox_axis_1_t)
  desc(sandbox_axis_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(GER)
  option:
    name(sandbox_axis_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, sudeten_unrest)
    $sandbox_add_rivalry_vs(CZE, 10)
    add_war_support(0.05)
  option:
    name(sandbox_axis_1_b)
    ai_chance:
      factor(15)

# Peak phase: ultimatum to Prague. Submit hurts; defy feeds Berlin.
country_event:
  id(sandbox_axis.3)
  title(sandbox_axis_3_t)
  desc(sandbox_axis_3_d)
  picture(GFX_news_event_001)
  is_triggered_only(yes)
  trigger:
    tag(CZE)
  option:
    name(sandbox_axis_3_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    GER:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, czech_submit)
  option:
    name(sandbox_axis_3_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    GER:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(CZE, 15)
    $sandbox_log_sc(sc_crisis, czech_defy)

# Peak phase: ultimatum to Warsaw. Submit hurts; defy feeds Berlin.
country_event:
  id(sandbox_axis.2)
  title(sandbox_axis_2_t)
  desc(sandbox_axis_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(POL)
  option:
    name(sandbox_axis_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    GER:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, polish_submit)
  option:
    name(sandbox_axis_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    GER:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(POL, 15)
    $sandbox_log_sc(sc_crisis, polish_defy)

# Peak phase: a top-2 open-pool candidate is offered a place in the Axis.
# Whoever accepts leaves its old faction first (leave-then-join); the exit
# carries no Honor charge (one-shot skip flag, same as a released nation).
# GER leads: if Berlin has no faction yet, the event creates it under the
# Axis name. The trigger locks AI-only outsiders (the scorer picks them,
# but a drifted fire must fizzle instead of inviting the wrong country).
country_event:
  id(sandbox_axis.4)
  title(sandbox_axis_4_t)
  desc(sandbox_axis_4_d)
  picture(GFX_news_event_004)
  is_triggered_only(yes)
  trigger:
    is_ai(yes)
    not is_in_faction_with(GER)
  option:
    name(sandbox_axis_4_a)
    ai_chance:
      factor(90)
    if is_in_faction(yes):
      set_country_flag(sandbox_honor_skip_leave_faction)
      leave_faction(yes)
    GER:
      if is_in_faction(no):
        create_faction(sandbox_axis_faction)
      add_to_faction(PREV)
      $add_opinion_modifier(PREV, scenario_ally)
    $add_opinion_modifier(GER, scenario_ally)
    $sandbox_log_sc(sc_join, axis_joined)
  option:
    name(sandbox_axis_4_b)
    ai_chance:
      factor(10)

