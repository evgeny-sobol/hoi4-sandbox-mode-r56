    ai_chance:
      factor(30)
    add_war_support(-0.10)
    GER:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, USA_submit)
  option:
    name(sandbox_ger_atl_3_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    GER:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(USA, 15)
    $sandbox_log_sc(sc_crisis, USA_defy)
