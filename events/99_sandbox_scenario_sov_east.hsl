# gdd/Scenarios Catalog.md: arc events for sov_east. 
# ids sandbox_sov_east.1-3. Same anatomy as other arcs.
add_namespace(sandbox_sov_east)

# Crisis: The Eastern Frontier.
country_event:
  id(sandbox_sov_east.1)
  title(sandbox_sov_east_1_t)
  desc(sandbox_sov_east_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(SOV)
  option:
    name(sandbox_sov_east_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, eastern_crisis)
    $sandbox_add_rivalry_vs(JAP, 10)
    add_war_support(0.05)
  option:
    name(sandbox_sov_east_1_b)
    ai_chance:
      factor(15)

# Ultimatum to JAP.
country_event:
  id(sandbox_sov_east.2)
  title(sandbox_sov_east_2_t)
  desc(sandbox_sov_east_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(JAP)
  option:
    name(sandbox_sov_east_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    SOV:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, JAP_submit)
  option:
    name(sandbox_sov_east_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    SOV:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(JAP, 15)
    $sandbox_log_sc(sc_crisis, JAP_defy)

