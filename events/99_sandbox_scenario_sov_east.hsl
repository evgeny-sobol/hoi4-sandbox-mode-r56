      factor(30)
    add_war_support(-0.10)
    SOV:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, MAN_submit)
  option:
    name(sandbox_sov_east_3_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    SOV:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(MAN, 15)
    $sandbox_log_sc(sc_crisis, MAN_defy)
