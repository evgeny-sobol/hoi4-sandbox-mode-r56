# docs/gdd/Scenarios Catalog.md: arc events for jap_communist.
# ids sandbox_jap_communist.1 (crisis) + N ultimatums covering variant A and B targets.
add_namespace(sandbox_jap_communist)

# Crisis: The Red Rising Sun.
country_event:
  id(sandbox_jap_communist.1)
  title(sandbox_jap_communist_1_t)
  desc(sandbox_jap_communist_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(JAP)
  option:
    name(sandbox_jap_communist_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, jap_communist_crisis)
    add_war_support(0.05)
  option:
    name(sandbox_jap_communist_1_b)
    ai_chance:
      factor(15)
    add_war_support(0.02)
# Ultimatum 2 (CHI | ENG).
country_event:
  id(sandbox_jap_communist.2)
  title(sandbox_jap_communist_2_t)
  desc(sandbox_jap_communist_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(CHI | ENG)
  option:
    name(sandbox_jap_communist_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    JAP:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, jap_communist_ult_2_submit)
  option:
    name(sandbox_jap_communist_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    JAP:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PREV, 15)
    $sandbox_log_sc(sc_crisis, jap_communist_ult_2_defy)
