# Focus-queued ignitions: POR_center_stage_against_communism and
# POR_ally_anti_colonial_resistance queue portugal.44 / portugal.45. A focus
# ignition is exempt from the cap (docs/gdd/Civil Wars.md "Focus exemption"),
# so no overlay. The log stays.
country_event[id = portugal.44]:
  +immediate:
    $sandbox_log_cw_event(portugal.44)

country_event[id = portugal.45]:
  +immediate:
    $sandbox_log_cw_event(portugal.45)
