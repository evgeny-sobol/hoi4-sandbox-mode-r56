# docs/gdd/Scenarios Catalog.md: arc events for eng_communist.
# ids sandbox_eng_communist.1 (crisis) + N ultimatums covering variant A and B targets.
add_namespace(sandbox_eng_communist)

# Crisis: The Red Union Jack.
country_event:
  id(sandbox_eng_communist.1)
  title(sandbox_eng_communist_1_t)
  desc(sandbox_eng_communist_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(ENG)
  option:
    name(sandbox_eng_communist_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, eng_communist_crisis)
    add_war_support(0.05)
  option:
    name(sandbox_eng_communist_1_b)
    ai_chance:
      factor(15)
    add_war_support(0.02)
# Ultimatum 2 (GER | SOV).
country_event:
  id(sandbox_eng_communist.2)
  title(sandbox_eng_communist_2_t)
  desc(sandbox_eng_communist_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(GER | SOV)
  option:
    name(sandbox_eng_communist_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    ENG:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, eng_communist_ult_2_submit)
  option:
    name(sandbox_eng_communist_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    ENG:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PREV, 15)
    $sandbox_log_sc(sc_crisis, eng_communist_ult_2_defy)
