# docs/gdd/Scenarios Catalog.md: arc events for fra_monarchist.
# ids sandbox_fra_monarchist.1 (crisis) + N ultimatums covering variant A and B targets.
add_namespace(sandbox_fra_monarchist)

# Crisis: The Legitimist Revival.
country_event:
  id(sandbox_fra_monarchist.1)
  title(sandbox_fra_monarchist_1_t)
  desc(sandbox_fra_monarchist_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(FRA)
  option:
    name(sandbox_fra_monarchist_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, fra_monarchist_crisis)
    add_war_support(0.05)
  option:
    name(sandbox_fra_monarchist_1_b)
    ai_chance:
      factor(15)
    add_war_support(0.02)
# Ultimatum 2 (SPR | SOV).
country_event:
  id(sandbox_fra_monarchist.2)
  title(sandbox_fra_monarchist_2_t)
  desc(sandbox_fra_monarchist_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(SPR | SOV)
  option:
    name(sandbox_fra_monarchist_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    FRA:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, fra_monarchist_ult_2_submit)
  option:
    name(sandbox_fra_monarchist_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    FRA:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PREV, 15)
    $sandbox_log_sc(sc_crisis, fra_monarchist_ult_2_defy)
