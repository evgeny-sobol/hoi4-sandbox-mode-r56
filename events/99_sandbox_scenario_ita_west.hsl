  option:
    name(sandbox_ita_west_3_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    ITA:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, ENG_submit)
  option:
    name(sandbox_ita_west_3_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    ITA:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(ENG, 15)
    $sandbox_log_sc(sc_crisis, ENG_defy)
