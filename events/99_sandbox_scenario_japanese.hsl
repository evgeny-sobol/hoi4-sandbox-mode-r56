# docs/gdd/Scenarios.md "Arc 3: Japanese expansion": crisis events. Fired from
# sandbox_scenario_tick phase transitions, same tick (triggered-only).
# ids sandbox_japanese.1-4. Same anatomy as the Axis/Soviet events with
# Japanese flavor; AI options carry the design, players choose freely. Every
# event carries a scope lock (tag or outsider trigger): delayed or drifted
# fires fizzle instead of executing in the wrong country.
# Event ids are namespace-qualified: vanilla rejects dotted ids without it.
add_namespace(sandbox_japanese)

# Crises phase: the China incident lands on the desk in Tokyo.
country_event:
  id(sandbox_japanese.1)
  title(sandbox_japanese_1_t)
  desc(sandbox_japanese_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(JAP)
  option:
    name(sandbox_japanese_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, china_incident)
    $sandbox_add_rivalry_vs(CHI, 10)
    add_war_support(0.05)
  option:
    name(sandbox_japanese_1_b)
    ai_chance:
      factor(15)

# Peak phase: ultimatum to Manila. Submit hurts; defy feeds Tokyo.
country_event:
  id(sandbox_japanese.3)
  title(sandbox_japanese_3_t)
  desc(sandbox_japanese_3_d)
  picture(GFX_news_event_001)
  is_triggered_only(yes)
  trigger:
    tag(PHI)
  option:
    name(sandbox_japanese_3_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    JAP:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, philippine_submit)
  option:
    name(sandbox_japanese_3_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    JAP:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PHI, 15)
    $sandbox_log_sc(sc_crisis, philippine_defy)

# Peak phase: ultimatum to Nanjing. Submit hurts; defy feeds Tokyo.
country_event:
  id(sandbox_japanese.2)
  title(sandbox_japanese_2_t)
  desc(sandbox_japanese_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(CHI)
  option:
    name(sandbox_japanese_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    JAP:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, chinese_submit)
  option:
    name(sandbox_japanese_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    JAP:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(CHI, 15)
    $sandbox_log_sc(sc_crisis, chinese_defy)

# Peak phase: a top-2 open-pool candidate is offered a place in the
# Co-Prosperity Sphere. Whoever accepts leaves its old faction first
# (leave-then-join); the exit carries no Honor charge (one-shot skip flag,
# same as a released nation). JAP leads: if Tokyo has no faction yet, the
# event creates it under the Co-Prosperity name. The trigger locks AI-only
# outsiders (the scorer picks them, but a drifted fire must fizzle instead
# of inviting the wrong country).
country_event:
  id(sandbox_japanese.4)
  title(sandbox_japanese_4_t)
  desc(sandbox_japanese_4_d)
  picture(GFX_news_event_004)
  is_triggered_only(yes)
  trigger:
    is_ai(yes)
    not is_in_faction_with(JAP)
  option:
    name(sandbox_japanese_4_a)
    ai_chance:
      factor(90)
    if is_in_faction(yes):
      set_country_flag(sandbox_honor_skip_leave_faction)
      leave_faction(yes)
    JAP:
      if is_in_faction(no):
        create_faction(sandbox_japanese_faction)
      add_to_faction(PREV)
      $add_opinion_modifier(PREV, scenario_ally)
    $add_opinion_modifier(JAP, scenario_ally)
    $sandbox_log_sc(sc_join, japanese_joined)
  option:
    name(sandbox_japanese_4_b)
    ai_chance:
      factor(10)
# Variant B: crisis on the aggressor (JAP).
