# docs/gdd/Scenarios.md "Arc 2: Soviet expansion": crisis events. Fired from
# sandbox_scenario_tick phase transitions, same tick (triggered-only).
# ids sandbox_soviet.1-4. Same anatomy as the Axis events with Soviet
# flavor; AI options carry the design, players choose freely. Every event
# carries a scope lock (tag or outsider trigger): delayed or drifted fires
# fizzle instead of executing in the wrong country.
# Event ids are namespace-qualified: vanilla rejects dotted ids without it.
add_namespace(sandbox_soviet)

# Crises phase: frontier trouble lands on the desk in Moscow.
country_event:
  id(sandbox_soviet.1)
  title(sandbox_soviet_1_t)
  desc(sandbox_soviet_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(SOV)
  option:
    name(sandbox_soviet_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, kresy_unrest)
    $sandbox_add_rivalry_vs(POL, 10)
    add_war_support(0.05)
  option:
    name(sandbox_soviet_1_b)
    ai_chance:
      factor(15)

# Peak phase: ultimatum to Helsinki. Submit hurts; defy feeds Moscow.
country_event:
  id(sandbox_soviet.3)
  title(sandbox_soviet_3_t)
  desc(sandbox_soviet_3_d)
  picture(GFX_news_event_001)
  is_triggered_only(yes)
  trigger:
    tag(FIN)
  option:
    name(sandbox_soviet_3_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    SOV:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, finnish_submit)
  option:
    name(sandbox_soviet_3_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    SOV:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(FIN, 15)
    $sandbox_log_sc(sc_crisis, finnish_defy)

# Peak phase: ultimatum to Warsaw. Submit hurts; defy feeds Moscow.
country_event:
  id(sandbox_soviet.2)
  title(sandbox_soviet_2_t)
  desc(sandbox_soviet_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(POL)
  option:
    name(sandbox_soviet_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    SOV:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, polish_submit)
  option:
    name(sandbox_soviet_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    SOV:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(POL, 15)
    $sandbox_log_sc(sc_crisis, polish_defy)

# Peak phase: a top-2 open-pool candidate is offered a place in the
# Comintern. Whoever accepts leaves its old faction first (leave-then-join);
# the exit carries no Honor charge (one-shot skip flag, same as a released
# nation). SOV leads: if Moscow has no faction yet, the event creates it
# under the Comintern name. The trigger locks AI-only outsiders (the scorer
# picks them, but a drifted fire must fizzle instead of inviting the wrong
# country).
country_event:
  id(sandbox_soviet.4)
  title(sandbox_soviet_4_t)
  desc(sandbox_soviet_4_d)
  picture(GFX_news_event_004)
  is_triggered_only(yes)
  trigger:
    is_ai(yes)
    not is_in_faction_with(SOV)
  option:
    name(sandbox_soviet_4_a)
    ai_chance:
      factor(90)
    if is_in_faction(yes):
      set_country_flag(sandbox_honor_skip_leave_faction)
      leave_faction(yes)
    SOV:
      if is_in_faction(no):
        create_faction(sandbox_soviet_faction)
      add_to_faction(PREV)
      $add_opinion_modifier(PREV, scenario_ally)
    $add_opinion_modifier(SOV, scenario_ally)
    $sandbox_log_sc(sc_join, soviet_joined)
  option:
    name(sandbox_soviet_4_b)
    ai_chance:
      factor(10)

