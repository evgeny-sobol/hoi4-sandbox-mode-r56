# gdd/Scenarios Catalog.md: arc events for sov_white.
# ids sandbox_sov_white.1 (crisis) + N ultimatums covering variant A and B targets.
add_namespace(sandbox_sov_white)

# Crisis: The White Counter-Revolution.
country_event:
  id(sandbox_sov_white.1)
  title(sandbox_sov_white_1_t)
  desc(sandbox_sov_white_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(SOV)
  option:
    name(sandbox_sov_white_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, sov_white_crisis)
    add_war_support(0.05)
  option:
    name(sandbox_sov_white_1_b)
    ai_chance:
      factor(15)
    add_war_support(0.02)
# Ultimatum 2 (GER | UKR).
country_event:
  id(sandbox_sov_white.2)
  title(sandbox_sov_white_2_t)
  desc(sandbox_sov_white_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(GER | UKR)
  option:
    name(sandbox_sov_white_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    SOV:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, sov_white_ult_2_submit)
  option:
    name(sandbox_sov_white_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    SOV:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(PREV, 15)
    $sandbox_log_sc(sc_crisis, sov_white_ult_2_defy)
