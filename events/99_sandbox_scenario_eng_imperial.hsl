# gdd/Scenarios Catalog.md: arc events for eng_imperial.
# ids sandbox_eng_imperial.1 (crisis) + N ultimatums covering variant A and B targets.
add_namespace(sandbox_eng_imperial)

# Crisis: The Empire Reborn.
country_event:
  id(sandbox_eng_imperial.1)
  title(sandbox_eng_imperial_1_t)
  desc(sandbox_eng_imperial_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(ENG)
  option:
    name(sandbox_eng_imperial_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, eng_imperial_crisis)
    add_war_support(0.05)
  option:
    name(sandbox_eng_imperial_1_b)
    ai_chance:
      factor(15)
    add_war_support(0.02)
# Ultimatum 2 (RAJ | USA).
country_event:
  id(sandbox_eng_imperial.2)
  title(sandbox_eng_imperial_2_t)
  desc(sandbox_eng_imperial_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(RAJ | USA)
  option:
    name(sandbox_eng_imperial_2_a)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    ENG:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, eng_imperial_ult_2_submit)
  option:
    name(sandbox_eng_imperial_2_b)
    ai_chance:
      factor(30)
    add_war_support(-0.05)
    $sandbox_log_sc(sc_crisis, eng_imperial_ult_2_defy)
# Ultimatum 3 (JAP).
country_event:
  id(sandbox_eng_imperial.3)
  title(sandbox_eng_imperial_3_t)
  desc(sandbox_eng_imperial_3_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(JAP)
  option:
    name(sandbox_eng_imperial_3_a)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    ENG:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, eng_imperial_ult_3_submit)
  option:
    name(sandbox_eng_imperial_3_b)
    ai_chance:
      factor(30)
    add_war_support(-0.05)
    $sandbox_log_sc(sc_crisis, eng_imperial_ult_3_defy)