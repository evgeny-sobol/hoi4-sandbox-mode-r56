# gdd/Scenarios.md "Arc 8: Habsburg restoration": crisis events. Fired from
# sandbox_scenario_tick phase transitions, same tick (triggered-only).
# ids sandbox_habsburg.1-4. Same anatomy as the other arcs' events with
# Hungarian flavor; AI options carry the design, players choose freely. Every
# event carries a scope lock (tag or outsider trigger): delayed or drifted
# fires fizzle instead of executing in the wrong country.
# Event ids are namespace-qualified: vanilla rejects dotted ids without it.
add_namespace(sandbox_habsburg)

# Crises phase: the Habsburg question lands on the desk in Budapest.
country_event:
  id(sandbox_habsburg.1)
  title(sandbox_habsburg_1_t)
  desc(sandbox_habsburg_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(HUN)
  option:
    name(sandbox_habsburg_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, habsburg_question)
    $sandbox_add_rivalry_vs(CZE, 10)
    add_war_support(0.05)
  option:
    name(sandbox_habsburg_1_b)
    ai_chance:
      factor(15)

# Peak phase: ultimatum to Bucharest. Submit hurts; defy feeds Budapest.
country_event:
  id(sandbox_habsburg.3)
  title(sandbox_habsburg_3_t)
  desc(sandbox_habsburg_3_d)
  picture(GFX_news_event_001)
  is_triggered_only(yes)
  trigger:
    tag(ROM)
  option:
    name(sandbox_habsburg_3_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    HUN:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, rumano_submit)
  option:
    name(sandbox_habsburg_3_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    HUN:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(ROM, 15)
    $sandbox_log_sc(sc_crisis, rumano_defy)

# Peak phase: ultimatum to Prague. Submit hurts; defy feeds Budapest.
country_event:
  id(sandbox_habsburg.2)
  title(sandbox_habsburg_2_t)
  desc(sandbox_habsburg_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(CZE)
  option:
    name(sandbox_habsburg_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    HUN:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, czech_submit)
  option:
    name(sandbox_habsburg_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    HUN:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(CZE, 15)
    $sandbox_log_sc(sc_crisis, czech_defy)

# Peak phase: a top-2 open-pool candidate is offered a place in the
# Danubian Empire. Whoever accepts leaves its old faction first
# (leave-then-join); the exit carries no Honor charge (one-shot skip flag,
# same as a released nation). HUN leads: if Budapest has no faction yet, the
# event creates it under the Danubian Empire name. The trigger locks AI-only
# outsiders (the scorer picks them, but a drifted fire must fizzle instead
# of inviting the wrong country).
country_event:
  id(sandbox_habsburg.4)
  title(sandbox_habsburg_4_t)
  desc(sandbox_habsburg_4_d)
  picture(GFX_news_event_004)
  is_triggered_only(yes)
  trigger:
    is_ai(yes)
    not is_in_faction_with(HUN)
  option:
    name(sandbox_habsburg_4_a)
    ai_chance:
      factor(90)
    if is_in_faction(yes):
      set_country_flag(sandbox_honor_skip_leave_faction)
      leave_faction(yes)
    HUN:
      if is_in_faction(no):
        create_faction(sandbox_habsburg_faction)
      add_to_faction(PREV)
      $add_opinion_modifier(PREV, scenario_ally)
    $add_opinion_modifier(HUN, scenario_ally)
    $sandbox_log_sc(sc_join, habsburg_joined)
  option:
    name(sandbox_habsburg_4_b)
    ai_chance:
      factor(10)
# Variant B: crisis on the aggressor (HUN).
