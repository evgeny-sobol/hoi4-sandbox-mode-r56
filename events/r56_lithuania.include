# Focus-queued ignitions: LIT_launch_the_revolution queues lithuania.16, and
# lithuania.109 is queued from a focus. A focus ignition is exempt from the cap
# (docs/gdd/Civil Wars.md "Focus exemption"), so no overlay. The log stays.
country_event[id = lithuania.16]:
  +immediate:
    $sandbox_log_cw_event(lithuania.16)

country_event[id = lithuania.109]:
  +immediate:
    $sandbox_log_cw_event(lithuania.109)
