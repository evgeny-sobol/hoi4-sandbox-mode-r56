# gdd/Scenarios Catalog.md: arc events for ita_communist.
# ids sandbox_ita_communist.1 (crisis) + N ultimatums covering variant A and B targets.
add_namespace(sandbox_ita_communist)

# Crisis: The Red Roman Revolution.
country_event:
  id(sandbox_ita_communist.1)
  title(sandbox_ita_communist_1_t)
  desc(sandbox_ita_communist_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(ITA)
  option:
    name(sandbox_ita_communist_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, ita_communist_crisis)
    add_war_support(0.05)
  option:
    name(sandbox_ita_communist_1_b)
    ai_chance:
      factor(15)
    add_war_support(0.02)
# Ultimatum 2 (FRA | BUL).
country_event:
  id(sandbox_ita_communist.2)
  title(sandbox_ita_communist_2_t)
  desc(sandbox_ita_communist_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(FRA | BUL)
  option:
    name(sandbox_ita_communist_2_a)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    ITA:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, ita_communist_ult_2_submit)
  option:
    name(sandbox_ita_communist_2_b)
    ai_chance:
      factor(30)
    add_war_support(-0.05)
    $sandbox_log_sc(sc_crisis, ita_communist_ult_2_defy)
# Ultimatum 3 (ENG | YUG).
country_event:
  id(sandbox_ita_communist.3)
  title(sandbox_ita_communist_3_t)
  desc(sandbox_ita_communist_3_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(ENG | YUG)
  option:
    name(sandbox_ita_communist_3_a)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    ITA:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, ita_communist_ult_3_submit)
  option:
    name(sandbox_ita_communist_3_b)
    ai_chance:
      factor(30)
    add_war_support(-0.05)
    $sandbox_log_sc(sc_crisis, ita_communist_ult_3_defy)