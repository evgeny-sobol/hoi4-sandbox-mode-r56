    $sandbox_log_sc(sc_crisis, variant_b_crisis)
    $sandbox_add_rivalry_vs(GER, 10)
    add_war_support(0.05)
  option:
    name(sandbox_britain_5_b)
    ai_chance:
      factor(15)

