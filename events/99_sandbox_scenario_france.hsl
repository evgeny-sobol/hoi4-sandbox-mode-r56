# gdd/Scenarios.md "Arc 7: Napoleonic France": crisis events. Fired from
# sandbox_scenario_tick phase transitions, same tick (triggered-only).
# ids sandbox_france.1-4. Same anatomy as the other arcs' events with French
# flavor; AI options carry the design, players choose freely. Every event
# carries a scope lock (tag or outsider trigger): delayed or drifted fires
# fizzle instead of executing in the wrong country.
# Event ids are namespace-qualified: vanilla rejects dotted ids without it.
add_namespace(sandbox_france)

# Crises phase: the Rhine incident lands on the desk in Paris.
country_event:
  id(sandbox_france.1)
  title(sandbox_france_1_t)
  desc(sandbox_france_1_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(FRA)
  option:
    name(sandbox_france_1_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, rhine_incident)
    $sandbox_add_rivalry_vs(GER, 10)
    add_war_support(0.05)
  option:
    name(sandbox_france_1_b)
    ai_chance:
      factor(15)

# Peak phase: ultimatum to Berlin. Submit hurts; defy feeds Paris.
country_event:
  id(sandbox_france.2)
  title(sandbox_france_2_t)
  desc(sandbox_france_2_d)
  picture(GFX_news_event_005)
  is_triggered_only(yes)
  trigger:
    tag(GER)
  option:
    name(sandbox_france_2_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    FRA:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, german_submit)
  option:
    name(sandbox_france_2_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    FRA:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(GER, 15)
    $sandbox_log_sc(sc_crisis, german_defy)

# Peak phase: ultimatum to Rome. Submit hurts; defy feeds Paris.
country_event:
  id(sandbox_france.3)
  title(sandbox_france_3_t)
  desc(sandbox_france_3_d)
  picture(GFX_news_event_001)
  is_triggered_only(yes)
  trigger:
    tag(ITA)
  option:
    name(sandbox_france_3_a)
    ai_chance:
      factor(30)
    add_war_support(-0.10)
    FRA:
      add_war_support(0.05)
    $sandbox_log_sc(sc_crisis, italian_submit)
  option:
    name(sandbox_france_3_b)
    ai_chance:
      factor(70)
    add_war_support(0.10)
    FRA:
      add_war_support(0.05)
      $sandbox_add_rivalry_vs(ITA, 15)
    $sandbox_log_sc(sc_crisis, italian_defy)

# Peak phase: a top-2 open-pool candidate is offered a place in the
# Continental System. Whoever accepts leaves its old faction first
# (leave-then-join); the exit carries no Honor charge (one-shot skip flag,
# same as a released nation). FRA leads: if Paris has no faction yet, the
# event creates it under the Continental System name. The trigger locks
# AI-only outsiders (the scorer picks them, but a drifted fire must fizzle
# instead of inviting the wrong country).
country_event:
  id(sandbox_france.4)
  title(sandbox_france_4_t)
  desc(sandbox_france_4_d)
  picture(GFX_news_event_004)
  is_triggered_only(yes)
  trigger:
    is_ai(yes)
    not is_in_faction_with(FRA)
  option:
    name(sandbox_france_4_a)
    ai_chance:
      factor(90)
    if is_in_faction(yes):
      set_country_flag(sandbox_honor_skip_leave_faction)
      leave_faction(yes)
    FRA:
      if is_in_faction(no):
        create_faction(sandbox_france_faction)
      add_to_faction(PREV)
      $add_opinion_modifier(PREV, scenario_ally)
    $add_opinion_modifier(FRA, scenario_ally)
    $sandbox_log_sc(sc_join, french_joined)
  option:
    name(sandbox_france_4_b)
    ai_chance:
      factor(10)
# Variant B: crisis on the aggressor (FRA).
country_event:
  id(sandbox_france.5)
  title(sandbox_france_5_t)
  desc(sandbox_france_5_d)
  picture(GFX_news_event_002)
  is_triggered_only(yes)
  trigger:
    tag(FRA)
  option:
    name(sandbox_france_5_a)
    ai_chance:
      factor(85)
    $sandbox_log_sc(sc_crisis, variant_b_crisis)
    $sandbox_add_rivalry_vs(ENG, 10)
    add_war_support(0.05)
  option:
    name(sandbox_france_5_b)
    ai_chance:
      factor(15)

