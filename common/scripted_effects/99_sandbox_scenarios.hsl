# Runs in the aggressor's scope. Each live target slot gets seeded as a
# rival and both sides record scenario_enemies[].
sandbox_seed_from_targets():
  add_war_support(0.10)
  if sandbox_targets[0] != 0:
    var:sandbox_targets[0]:
      PREV:
        $sandbox_seed_rival(PREV, 65)
        &scenario_enemies[].add(PREV)
  if sandbox_targets[1] != 0:
    var:sandbox_targets[1]:
      PREV:
        $sandbox_seed_rival(PREV, 65)
        &scenario_enemies[].add(PREV)
  if sandbox_targets[2] != 0:
    var:sandbox_targets[2]:
      PREV:
        $sandbox_seed_rival(PREV, 65)
        &scenario_enemies[].add(PREV)
    # Symmetric side: each target lists the aggressor (scoped as PREV at the
    # var: head; THIS is the target country, PREV is the aggressor tag).
  if sandbox_targets[0] != 0:
    var:sandbox_targets[0]:
      PREV:
        &scenario_enemies[].add(PREV)
  if sandbox_targets[1] != 0:
    var:sandbox_targets[1]:
      PREV:
        &scenario_enemies[].add(PREV)
  if sandbox_targets[2] != 0:
    var:sandbox_targets[2]:
      PREV:
        &scenario_enemies[].add(PREV)
# Monthly ladder tick. Thresholds are HAI months_elapsed: < 12 smolder,
# 12-23 crises, 24+ peak. Each rung fires once (anti-spam by construction)
# and releases its crisis events the same tick (no day offsets: delayed
# fires can drift across tags in sandbox tag churn; each event also carries
# a tag trigger as a second lock). A derail check runs first; a derailed
# arc parks at phase 3 (ended) and the rung arms below go quiet.
sandbox_scenario_tick():
  if global.sandbox_scenario == 0:
    pass
  else:
    sandbox_scenario_check_derail()
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 0 and months_elapsed >= 12:
    global.&sandbox_scenario_phase = 1
    $sandbox_log_sc(sc_phase, crises)
    sandbox_fire_axis_crises()
  elif global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 1 and months_elapsed >= 24:
    global.&sandbox_scenario_phase = 2
    $sandbox_log_sc(sc_phase, peak)
    sandbox_fire_axis_peak()
