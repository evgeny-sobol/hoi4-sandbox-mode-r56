# gdd/Scenarios.md "Selection": repick after a derail on random sessions.
# Picks the eligible arc that has not derailed this session (a derailed arc
# never re-enters the pool); when pinned or when nothing is eligible the
# session stays quiet. Stale scenario_enemies from the dead arc are cleared
# first, or its wars would ignite (and Honor-exempt) the new arc. The new
# arc runs its ladder from smolder (compressed: late repicks hit crises and
# peak on consecutive ticks).
sandbox_scenario_maybe_repick():
  if global.sandbox_scenario_pin == 0:
    global.&sandbox_derailed_arcs[].add(global.sandbox_scenario)
    for every_country():
      &scenario_enemies[].clear()
    # Eligible = implemented arc whose actor exists and that has not derailed
    # this session. First eligible in arc order wins (deterministic).
    eligible[].clear()
    if country_exists(GER) and 1 not in global.sandbox_derailed_arcs[]:
      eligible[].add(1)
    if country_exists(SOV) and 2 not in global.sandbox_derailed_arcs[]:
      eligible[].add(2)
    if country_exists(JAP) and 3 not in global.sandbox_derailed_arcs[]:
      eligible[].add(3)
    if country_exists(ITA) and 4 not in global.sandbox_derailed_arcs[]:
      eligible[].add(4)
    if country_exists(ENG) and 5 not in global.sandbox_derailed_arcs[]:
      eligible[].add(5)
    if country_exists(USA) and 6 not in global.sandbox_derailed_arcs[]:
      eligible[].add(6)
    if country_exists(FRA) and 7 not in global.sandbox_derailed_arcs[]:
      eligible[].add(7)
    if country_exists(HUN) and 8 not in global.sandbox_derailed_arcs[]:
      eligible[].add(8)
    if country_exists(GER) and (9 not in global.sandbox_derailed_arcs[] or 10 not in global.sandbox_derailed_arcs[]):
      eligible[].add(9)
      eligible[].add(10)
    if country_exists(SOV) and (11 not in global.sandbox_derailed_arcs[] or 12 not in global.sandbox_derailed_arcs[]):
      eligible[].add(11)
      eligible[].add(12)
    if country_exists(JAP) and (13 not in global.sandbox_derailed_arcs[] or 14 not in global.sandbox_derailed_arcs[]):
      eligible[].add(13)
      eligible[].add(14)
    if country_exists(ITA) and 16 not in global.sandbox_derailed_arcs[]:
      eligible[].add(16)
    if country_exists(ENG) and 17 not in global.sandbox_derailed_arcs[]:
      eligible[].add(17)
    if country_exists(USA) and (18 not in global.sandbox_derailed_arcs[] or 19 not in global.sandbox_derailed_arcs[]):
      eligible[].add(18)
      eligible[].add(19)
    if country_exists(FRA) and (20 not in global.sandbox_derailed_arcs[] or 21 not in global.sandbox_derailed_arcs[] or 22 not in global.sandbox_derailed_arcs[]):
      eligible[].add(20)
      eligible[].add(21)
      eligible[].add(22)
    if country_exists(GER) and (23 not in global.sandbox_derailed_arcs[] or 24 not in global.sandbox_derailed_arcs[]):
      eligible[].add(23)
      eligible[].add(24)
    if country_exists(SOV) and 25 not in global.sandbox_derailed_arcs[]:
      eligible[].add(25)
    if country_exists(JAP) and 26 not in global.sandbox_derailed_arcs[]:
      eligible[].add(26)
    if country_exists(ITA) and 27 not in global.sandbox_derailed_arcs[]:
      eligible[].add(27)
    if country_exists(ENG) and 28 not in global.sandbox_derailed_arcs[]:
      eligible[].add(28)
    if eligible[].size() == 0:
      $sandbox_log_sc(sc_repick, none_eligible)
    else:
      global.&sandbox_scenario = eligible[0]
      global.&sandbox_scenario_phase = 0
      variant_roll = randi(0, 1)
      if variant_roll == 0:
        global.&sandbox_target_variant = a
      else:
        global.&sandbox_target_variant = b
      sandbox_set_targets()
      sandbox_seed_actors()
      if global.sandbox_scenario == 1:
        $sandbox_log_sc(sc_repick, axis_expansion)
        $sandbox_log_sc(sc_pick, axis_expansion)
      elif global.sandbox_scenario == 2:
