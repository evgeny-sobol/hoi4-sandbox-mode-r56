# gdd/Scenarios.md "Lifecycle": derail dispatcher. Snapshots the phase: a
# tick that parks a live arc parked it via derail (ignition only happens in
# on_declare_war), so a pinned session goes quiet and a random one repicks.
sandbox_scenario_check_derail():
  phase_before = global.sandbox_scenario_phase
  if global.sandbox_scenario == 1:
    sandbox_scenario_check_axis_derail()
  elif global.sandbox_scenario == 2:
    sandbox_scenario_check_soviet_derail()
  elif global.sandbox_scenario == 3:
