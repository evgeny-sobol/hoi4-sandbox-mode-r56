# Crises phase: the Sudeten incident lands on the desk in Berlin.
sandbox_fire_axis_crises():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 1:
    if global.sandbox_target_variant == a:
      GER:
        if country_exists(CZE) and not GER->has_war_with(CZE):
          GER:
            country_event:
              id(sandbox_axis.1)
    else:
      GER:
        if country_exists(FRA) and not GER->has_war_with(FRA):
          GER:
            country_event:
              id(sandbox_axis.5)


