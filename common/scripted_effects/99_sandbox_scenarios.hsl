# gdd/Scenarios.md "Lifecycle": park a dead Axis arc at phase 3 (ended).
# Called from the derail dispatcher. Arms are an elif chain, so exactly one
# reason fires. No standalone civil-war arm by design: a war the fascists
# win must not kill the arc. The ideology arm ignores wartime flips (they
# may revert) and fires once the war is over and Germany is still
# off-ideology. No player arm: pacifism is undetectable, and a human Germany
# playing along must not end the scenario. Neutralized targets (subject of
# GER or in its faction) count as removed: with no viable target on any
# vector the arc parks too.
sandbox_scenario_check_axis_derail():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase < 3:
    if not country_exists(GER):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, germany_gone)
      $sandbox_log_sc(sc_end, germany_gone)
    elif GER->has_capitulated():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, germany_capitulated)
      $sandbox_log_sc(sc_end, germany_capitulated)
    elif not GER->has_government(fascism) and not GER->has_civil_war():
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, germany_not_fascist)
      $sandbox_log_sc(sc_end, germany_not_fascist)
    elif not country_exists(CZE) and not country_exists(POL):
      global.&sandbox_scenario_phase = 3
      $sandbox_log_sc(sc_derail, targets_gone)
      $sandbox_log_sc(sc_end, targets_gone)
    else:
      if global.sandbox_target_variant == a:
        $sandbox_check_targets_derail2(GER, CZE, POL)
      else:
        $sandbox_check_targets_derail2(GER, FRA, ENG)# gdd/Scenarios.md "Lifecycle": park a dead Soviet arc at phase 3 (ended).
