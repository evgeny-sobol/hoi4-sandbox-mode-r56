# gdd/Scenarios.md "Lifecycle": any war between declared scenario enemies
# ignites the arc (symmetric, like the enemy list itself). Called unscoped
# from on_declare_war (THIS is the attacker, FROM the defender). The enemy
# list is per-session, so the gate is arc-agnostic; only the log value
# names the arc.
sandbox_scenario_ignite():
  if global.sandbox_scenario > 0 and global.sandbox_scenario_phase < 3 and FROM in &scenario_enemies[]:
    global.&sandbox_scenario_phase = 3
    if global.sandbox_scenario == 1:
      $sandbox_log_sc(sc_ignite, axis_war)
      $sandbox_log_sc(sc_end, axis_war)
    elif global.sandbox_scenario == 2:
      $sandbox_log_sc(sc_ignite, soviet_war)
      $sandbox_log_sc(sc_end, soviet_war)
