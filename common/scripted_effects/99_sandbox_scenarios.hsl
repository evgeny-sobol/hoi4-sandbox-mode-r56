# sc_target telemetry (gdd/Scenarios.md "Hooks and telemetry"): one status
# line per arc target at peak, explaining why its ultimatum fired or not.
# Runs in TARGET scope (THIS is CZE/POL); the aggressor is hardcoded GER
# (v1 single arc). First match wins: at_war > civil_war > subject >
# in_faction > open. Dead targets log cze_gone/pol_gone from GER scope
# (a dead tag cannot scope itself).
sandbox_log_axis_target_status():
  if has_war_with(GER):
    $sandbox_log_sc(sc_target, at_war)
  elif has_civil_war():
    $sandbox_log_sc(sc_target, civil_war)
  elif is_subject_of(GER):
    $sandbox_log_sc(sc_target, subject)
  elif is_in_faction_with(GER):
    $sandbox_log_sc(sc_target, in_faction)
  else:
    $sandbox_log_sc(sc_target, open)

# Peak phase: ultimatums to CZE and POL, top-2 open-pool join offers.
# Ultimatums fire for humans too (options are choices, fair to everyone);
# join offers are AI-only (a human plays diplomacy, not popups).
sandbox_fire_axis_peak():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase == 2:
    if global.sandbox_target_variant == a:
      if country_exists(CZE):
        CZE:
          sandbox_log_axis_target_status()
      if country_exists(POL):
        POL:
          sandbox_log_axis_target_status()
      if country_exists(CZE) and not GER->has_war_with(CZE):
        CZE:
          country_event:
            id(sandbox_axis.2)
      if country_exists(POL) and not GER->has_war_with(POL):
        POL:
          country_event:
            id(sandbox_axis.3)
    else:
      if country_exists(FRA):
        FRA:
          sandbox_log_axis_target_status()
      if country_exists(ENG):
        ENG:
          sandbox_log_axis_target_status()
      if country_exists(FRA) and not GER->has_war_with(FRA):
        FRA:
          country_event:
            id(sandbox_axis.6)
      if country_exists(ENG) and not GER->has_war_with(ENG):
        ENG:
          country_event:
            id(sandbox_axis.7)
    GER:
      sandbox_select_axis_joiners()
