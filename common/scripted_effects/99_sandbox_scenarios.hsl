# s7 diagnostic (read-only): monthly strength + wargoal snapshot for arc
# actors while the arc is alive. Temps and logs only; no game state changes.
# sc_power carries divisions + factories per live actor; sc_goal logs held
# wargoals between GER and its targets (positives only).
sandbox_scenario_s7_telemetry():
  if global.sandbox_scenario == 1 and global.sandbox_scenario_phase < 3:
    if global.sandbox_target_variant == a:
      GER:
        sc_div = num_divisions
        sc_fab = num_of_factories
        $sandbox_log_sc_power()
      if country_exists(CZE):
        CZE:
          sc_div = num_divisions
          sc_fab = num_of_factories
          $sandbox_log_sc_power()
      if country_exists(POL):
        POL:
          sc_div = num_divisions
          sc_fab = num_of_factories
          $sandbox_log_sc_power()
      GER:
        if has_wargoal_against(CZE):
          $sandbox_log_sc(sc_goal, ger_on_cze)
        if has_wargoal_against(POL):
