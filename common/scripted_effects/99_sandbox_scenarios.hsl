# Shared join-2.0 helper: industry snapshot for the scorer.
# num_of_factories is script math with no plain trigger, so export it into
# a persistent country variable first; temp would not survive into the
# scorer's scope.
sandbox_snapshot_join_industry():
  for every_country():
    &scenario_join_industry = num_of_factories

# Join 2.0 (gdd/Scenarios.md "Join levers"): open-pool top-2 by
# scenario_join_scorer. Runs in GER scope so the scorer's FROM is the
# aggressor. Deterministic: candidates[0..1] with score > 0 get letters
# (one sc_offer each); gated (0) or missing slots get none. Temp arrays
# (one shot at peak, read in the same scope); tags never enter variables.
sandbox_select_axis_joiners():
  sandbox_snapshot_join_industry()
  get_sorted_scored_countries(scenario_join_scorer, scenario_join_candidates[], scenario_join_scores[])
  if scenario_join_scores[0] > 0:
    var:scenario_join_candidates[0]:
      country_event:
        id(sandbox_axis.4)
      $sandbox_log_sc(sc_offer, invited)
  if scenario_join_scores[1] > 0:
    var:scenario_join_candidates[1]:
      country_event:
        id(sandbox_axis.4)
      $sandbox_log_sc(sc_offer, invited)

