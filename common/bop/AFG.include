# Pattern C at the BoP caller. Skip the whole IF so AFG_had_civil_war_bop is
# not set; weekly sandbox_retry_afg_bop_civil_war_fuse re-runs the payload
# while the range is still live.
AFG_power_balance:
  side[id = AFG_government_side]:
    range[id = AFG_total_government_influence]:
      on_activate:
        if:
          limit:
            sandbox_civil_war_ai_allowed()
          $sandbox_log_cw_event(AFG_total_government_influence)
