# Per-mod arc hooks for the shared on_actions skeleton
# (core/common/on_actions/99_sandbox_core_on_actions.hsl).
# Regenerate with tools/extract_arc_hooks.py after editing the arc table.

sandbox_arc_on_weekly():
  sandbox_retry_afg_bop_civil_war_fuse()

sandbox_arc_tick_hosts():
    if not country_exists(HAI) and not country_exists(GER) and not country_exists(SOV) and not country_exists(JAP) and not country_exists(ITA) and not country_exists(ENG) and not country_exists(USA) and tag(FRA):
      sandbox_scenario_tick()
    elif not country_exists(HAI) and not country_exists(GER) and not country_exists(SOV) and not country_exists(JAP) and not country_exists(ITA) and not country_exists(ENG) and not country_exists(USA) and not country_exists(FRA) and tag(HUN):
      sandbox_scenario_tick()

