  focus[id = DEN_Reclaim_our_Baltic_Possessions]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($EST) + $opinion_factor($LAT) + $opinion_factor($SOV)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        rivalry_vs = 0
        $rivalry_vs_into($EST)
        $rivalry_vs_into($LAT)
        $rivalry_vs_into($SOV)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      modifier:
        $ai_betrayal_modifier()
        or:
          $EST->is_friend_of_PREV()
          $LAT->is_friend_of_PREV()
          $SOV->is_friend_of_PREV()

