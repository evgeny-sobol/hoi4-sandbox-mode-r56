  focus[id = ICE_vikings]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($NOR) + $opinion_factor($DEN) + $opinion_factor($SWE)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($NOR)
        $rivalry_vs_into($DEN)
        $rivalry_vs_into($SWE)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $NOR->is_friend_of_PREV()
          $DEN->is_friend_of_PREV()
          $SWE->is_friend_of_PREV()

