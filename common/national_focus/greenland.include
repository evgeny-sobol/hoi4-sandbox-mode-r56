      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_mic_modifier()

  focus[id = GRN_prospecting_new_sites]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_mic_modifier()

  focus[id = GRN_protect_greenland]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_mic_modifier()

  focus[id = GRN_the_carrier_which_came_in_from_the_cold]:
