      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()
      modifier:
        $ai_mic_modifier()

  focus[id = GRN_encourage_fishing]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = GRN_expand_the_ivittuut_mine]:
