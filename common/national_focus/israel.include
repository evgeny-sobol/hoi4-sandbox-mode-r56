      modifier:
        antagonism = 1 - ($opinion_factor($EGY) + $opinion_factor($PAL)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        $ai_rivalry_modifier_max($EGY, $PAL)
      modifier:
        $ai_betrayal_modifier()
        or:
          $EGY->is_friend_of_PREV()
          $PAL->is_friend_of_PREV()
