  focus[id = SOV_strike_the_eagle_old]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($GER) + $opinion_factor($PRE)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($GER, $PRE)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $GER->is_friend_of_PREV()
          $PRE->is_friend_of_PREV()
    available:
      $GER->can_PREV_get_wargoal_on_THIS()
      $PRE->can_PREV_get_wargoal_on_THIS()

