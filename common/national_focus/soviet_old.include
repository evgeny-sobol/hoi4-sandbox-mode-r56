        $rivalry_vs_into($ENG)
        $rivalry_vs_into($FRA)
        $rivalry_vs_into($GER)
        $rivalry_vs_into($ITA)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ENG->is_friend_of_PREV()
          $FRA->is_friend_of_PREV()
          $GER->is_friend_of_PREV()
          $ITA->is_friend_of_PREV()

