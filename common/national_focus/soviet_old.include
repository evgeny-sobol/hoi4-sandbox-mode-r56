  focus[id = SOV_return_to_the_baltics_old]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($EST) + $opinion_factor($LAT) + $opinion_factor($LIT)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($EST)
        $rivalry_vs_into($LAT)
        $rivalry_vs_into($LIT)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $EST->is_friend_of_PREV()
          $LAT->is_friend_of_PREV()
          $LIT->is_friend_of_PREV()

  focus[id = SOV_reclaim_polish_overlordship_old]:
