focus_tree[id = jordan_focus]:

  focus[id = JOR_national_conference]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()

  focus[id = JOR_appease_tribes]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = JOR_salvage_ottoman_assets]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_mic_modifier()

  focus[id = JOR_circassion_integration]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = JOR_begin_treaty_discussions]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = JOR_ally_opposition]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_civil_war_root_modifier()
    +completion_reward:
      $sandbox_log_cw_root(JOR_ally_opposition)

  focus[id = JOR_rally_orthodox]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = JOR_meet_arabs]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = JOR_revolt]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_civil_war_ignition_modifier()
      +modifier:
        factor(0)
        sandbox_civil_war_cap_reached()
    +completion_reward:
      $sandbox_log_cw_ignition(JOR_revolt)

  focus[id = JOR_operation_hashem]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = JOR_utaybah_victory]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = JOR_army_victory]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
