  focus[id = PAL_bring_back_into_fold]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($IRQ) + $opinion_factor($JOR) + $opinion_factor($PREV)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($IRQ)
        $rivalry_vs_into($JOR)
        $rivalry_vs_into($PREV)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $IRQ->is_friend_of_PREV()
          $JOR->is_friend_of_PREV()
          $PREV->is_friend_of_PREV()

