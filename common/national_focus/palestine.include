  focus[id = PAL_end_the_murtadeen_reign]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($PREV) + $opinion_factor($TUR)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($PREV, $TUR)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $PREV->is_friend_of_PREV()
          $TUR->is_friend_of_PREV()
    +available:
      $PREV->can_PREV_get_wargoal_on_THIS()
      $TUR->can_PREV_get_wargoal_on_THIS()

