focus_tree[id = oman_focus]:

  focus[id = OMA_establish_the_rial]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = OMA_reclaim_the_northern_lands]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        $ai_antagonism_modifier($PREV)
      modifier:
        $ai_rivalry_modifier($PREV)
      modifier:
        $ai_betrayal_modifier_vs($PREV)
    available:
      $PREV->can_PREV_get_wargoal_on_THIS()

  focus[id = OMA_across_the_gulf]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        $ai_antagonism_modifier($PREV)
      modifier:
        $ai_rivalry_modifier($PREV)
      modifier:
        $ai_betrayal_modifier_vs($PREV)
    available:
      $PREV->can_PREV_get_wargoal_on_THIS()

  focus[id = OMA_our_african_holdings]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        $ai_antagonism_modifier($PREV)
      modifier:
        $ai_rivalry_modifier($PREV)
      modifier:
        $ai_betrayal_modifier_vs($PREV)
    available:
      $PREV->can_PREV_get_wargoal_on_THIS()

  focus[id = OMA_tear_up_the_treaties]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
