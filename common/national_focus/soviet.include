        $ai_sandbox_modifier()
      +modifier:
        factor(0)
        NOT:
          or:
            has_completed_focus(SOV_womens_fascist_movement)
            has_completed_focus(SOV_the_true_tsars)
            has_completed_focus(SOV_national_unification)
            has_completed_focus(SOV_embrace_the_black_hundreds)
            has_completed_focus(SOV_covert_operations)
            has_completed_focus(SOV_muster_the_old_guard)
            has_completed_focus(SOV_fascist_youth_union)
            has_completed_focus(SOV_approach_semyonov)
            has_completed_focus(SOV_organize_wreckers)
            has_completed_focus(SOV_tolkachi)
            has_completed_focus(SOV_south_manchuria_railway)
            has_completed_focus(SOV_the_eyes_fear)
        is_sandbox_mode_on()
      +modifier:
        add(4)
        has_completed_focus(SOV_womens_fascist_movement)
        is_sandbox_mode_on()
      +modifier:
        add(4)
        has_completed_focus(SOV_the_true_tsars)
        is_sandbox_mode_on()
      +modifier:
        add(4)
        has_completed_focus(SOV_national_unification)
        is_sandbox_mode_on()
