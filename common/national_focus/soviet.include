      $sandbox_log_cw_ignition(SOV_the_hands_do)

  focus[id = SOV_call_for_aid]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = SOV_request_imperial_protection]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        factor(0.0)
        or:
          and:
            $compare(surrender_progress, "<", 0.1)
            any_enemy_country:
              original_tag(SOV)
              $compare(surrender_progress, ">", 0.5)
            $compare(date, "<", "1938.6.1")
          and:
            any_enemy_country:
              original_tag(SOV)
              $compare(surrender_progress, ">", 0.75)
            $compare(date, "<", "1939.8.1")
          and:
            $compare(surrender_progress, "<", 0.5)
            $JAP->has_war()
        is_sandbox_mode_on()

