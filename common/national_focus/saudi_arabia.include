        $crossroad_modifier(2)

  focus[id = SAU_war_with_yemen_and_oman]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($YEM) + $opinion_factor($OMA)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($YEM, $OMA)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $YEM->is_friend_of_PREV()
          $OMA->is_friend_of_PREV()
    +available:
      $YEM->can_PREV_get_wargoal_on_THIS()
      $OMA->can_PREV_get_wargoal_on_THIS()

  focus[id = SAU_crush_the_golden_square]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($IRQ)
      +modifier:
        $ai_rivalry_modifier($IRQ)
      +modifier:
        $ai_betrayal_modifier_vs($IRQ)
    +available:
      $IRQ->can_PREV_get_wargoal_on_THIS()

  focus[id = SAU_establish_labor_camps]:
