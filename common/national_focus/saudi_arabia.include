  focus[id = SAU_claim_the_sinai]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = SAU_our_rightful_domain]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($IRQ) + $opinion_factor($ENG) + $opinion_factor($FRA) + $opinion_factor($ITA)) / 4
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($IRQ)
        $rivalry_vs_into($ENG)
        $rivalry_vs_into($FRA)
        $rivalry_vs_into($ITA)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $IRQ->is_friend_of_PREV()
          $ENG->is_friend_of_PREV()
          $FRA->is_friend_of_PREV()
          $ITA->is_friend_of_PREV()
