  focus[id = bra_pan_americano]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ARG) + $opinion_factor($URG)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($ARG, $URG)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ARG->is_friend_of_PREV()
          $URG->is_friend_of_PREV()
    available:
      $ARG->can_PREV_get_wargoal_on_THIS()
      $URG->can_PREV_get_wargoal_on_THIS()

