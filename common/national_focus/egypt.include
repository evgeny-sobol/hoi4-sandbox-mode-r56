focus_tree[id = egypt_focus]:

  focus[id = EGY_solidify_british_ties]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $ai_civil_war_root_modifier()
    +completion_reward:
      $sandbox_log_cw_root(EGY_solidify_british_ties)

