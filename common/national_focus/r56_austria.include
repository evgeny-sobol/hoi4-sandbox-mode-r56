    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($HUN) + $opinion_factor($CZE) + $opinion_factor($YUG) + $opinion_factor($SWI)) / 4
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        rivalry_vs = 0
        $rivalry_vs_into($HUN)
        $rivalry_vs_into($CZE)
        $rivalry_vs_into($YUG)
        $rivalry_vs_into($SWI)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      modifier:
        $ai_betrayal_modifier()
        or:
          $HUN->is_friend_of_PREV()
          $CZE->is_friend_of_PREV()
          $YUG->is_friend_of_PREV()
          $SWI->is_friend_of_PREV()

