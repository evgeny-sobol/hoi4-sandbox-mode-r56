focus_tree[id = usa_focus]:

  focus[id = USA_continue_the_new_deal]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        f = 2 * (mtth:democracy_factor + mtth:communism_factor) /
          (2 * mtth:democracy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()

  focus[id = USA_double_victory]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = USA_fight_jim_crow_now]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = USA_suspend_the_presecution]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = 1 + mtth:communism_factor
        factor(f)

  focus[id = USA_desegregate_the_armed_forces]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = USA_democratic_socialism]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = USA_communist_secret_police]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
    available:
      is_liberal_leader(no)

  focus[id = USA_expand_the_intelligence_services]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = r56_USA_join_the_mexican_revolutionaries]:
