      +modifier:
        $ai_sandbox_modifier()

  focus[id = USA_full_desegregation]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = USA_liberty_for_the_philippines]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_cooperation_modifier($PHI)
      +modifier:
        factor(0)
        $PHI in rivals[]
        is_sandbox_mode_on()
    available:
      $not_rival_of_PREV($PHI)

  focus[id = USA_pacific_decolonisation]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        factor(USA_pacific_decolonisation_antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        any_other_country:
          THIS in ROOT.USA_pacific_decolonisation_targets[]
          is_friend_of_ROOT()
    +available:
      var:USA_pacific_decolonisation_targets[0]->can_PREV_get_wargoal_on_THIS()
      var:USA_pacific_decolonisation_targets[1]->can_PREV_get_wargoal_on_THIS()

  focus[id = USA_union_representation_act]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = 4 * mtth:communism_factor /
          (mtth:democracy_factor + mtth:communism_factor + mtth:fascism_factor)
        factor(f)
        is_sandbox_mode_on()
    completion_reward:
      $sandbox_log_cw_ignition(USA_union_representation_act)

  focus[id = USA_old_age_pension_act]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = USA_accumulated_wealth_tax_act]:
    ai_will_do:
      +modifier:
