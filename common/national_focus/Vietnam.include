  focus[id = VIN_finish_what_we_started]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($LAO) + $opinion_factor($CAM)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        $ai_rivalry_modifier_max($LAO, $CAM)
      modifier:
        $ai_betrayal_modifier()
        or:
          $LAO->is_friend_of_PREV()
          $CAM->is_friend_of_PREV()
    +available:
      $LAO->can_PREV_get_wargoal_on_THIS()
      $CAM->can_PREV_get_wargoal_on_THIS()

