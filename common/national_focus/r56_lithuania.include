    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($EST) + $opinion_factor($LAT)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($EST, $LAT)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $EST->is_friend_of_PREV()
          $LAT->is_friend_of_PREV()
    available:
      $EST->can_PREV_get_wargoal_on_THIS()
      $LAT->can_PREV_get_wargoal_on_THIS()

