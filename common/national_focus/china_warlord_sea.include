focus_tree[id = china_warlord_sea_focus]:

  focus[id = CHI_sea_secure_internal_politics]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()

  focus[id = CHI_sea_cooperation_with_the_nationalists]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(3)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($CHI)
      +modifier:
        $ai_rivalry_modifier($CHI)
