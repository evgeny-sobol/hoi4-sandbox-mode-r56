  focus[id = FRA_unify_the_metropole]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($COR) + $opinion_factor($OCC) + $opinion_factor($PREV)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($COR)
        $rivalry_vs_into($OCC)
        $rivalry_vs_into($PREV)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $COR->is_friend_of_PREV()
          $OCC->is_friend_of_PREV()
