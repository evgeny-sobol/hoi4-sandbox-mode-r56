  focus[id = ENG_secure_the_oil_imports]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($IRQ) + $opinion_factor($PER) +
          $opinion_factor($HOL) +
          $opinion_factor($VEN) +
          $opinion_factor($CRC)) / 5
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($IRQ)
        $rivalry_vs_into($PER)
        $rivalry_vs_into($HOL)
        $rivalry_vs_into($VEN)
        $rivalry_vs_into($CRC)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $IRQ->is_friend_of_PREV()
          $PER->is_friend_of_PREV()
          $HOL->is_friend_of_PREV()
          $VEN->is_friend_of_PREV()
          $CRC->is_friend_of_PREV()
    available:
      $IRQ->can_PREV_get_wargoal_on_THIS()
      $PER->can_PREV_get_wargoal_on_THIS()
      $HOL->can_PREV_get_wargoal_on_THIS()
      $VEN->can_PREV_get_wargoal_on_THIS()
      $CRC->can_PREV_get_wargoal_on_THIS()

  focus[id = ENG_maintaining_imperial_integrity]:
