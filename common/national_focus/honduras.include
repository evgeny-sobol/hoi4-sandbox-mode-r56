      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ECU) + $opinion_factor($COL)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($ECU, $COL)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ECU->is_friend_of_PREV()
          $COL->is_friend_of_PREV()
    available:
      $ECU->can_PREV_get_wargoal_on_THIS()
      $COL->can_PREV_get_wargoal_on_THIS()

