        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($CUB)
        $rivalry_vs_into($DOM)
        $rivalry_vs_into($HAI)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $CUB->is_friend_of_PREV()
          $DOM->is_friend_of_PREV()
