        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $GER->is_friend_of_PREV()
          $ITA->is_friend_of_PREV()
          $JAP->is_friend_of_PREV()

