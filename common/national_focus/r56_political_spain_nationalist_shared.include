
shared_focus[id = SPR_nationalist_victory]:
  ai_will_do:
    +modifier:
      $ai_sandbox_modifier()
    +modifier:
      $root_modifier()

shared_focus[id = SPR_cement_franco_rule]:
  ai_will_do:
    +modifier:
      $ai_sandbox_modifier()

shared_focus[id = SPR_crush_regional_governments_r56]:
  ai_will_do:
    +modifier:
      $ai_sandbox_modifier()
    +modifier:
      $ai_war_support_modifier()
    +modifier:
      antagonism = 1 - ($opinion_factor($ADU) + $opinion_factor($CAT) + $opinion_factor($GLC) + $opinion_factor($NAV)) / 4
      factor(antagonism)
      is_sandbox_mode_on()
    +modifier:
      rivalry_vs = 0
      $rivalry_vs_into($ADU)
      $rivalry_vs_into($CAT)
      $rivalry_vs_into($GLC)
      $rivalry_vs_into($NAV)
      f = 1 + rivalry_vs / 50
      factor(f)
      is_sandbox_mode_on()
    +modifier:
      $ai_betrayal_modifier()
      or:
        $ADU->is_friend_of_PREV()
        $CAT->is_friend_of_PREV()
        $GLC->is_friend_of_PREV()
        $NAV->is_friend_of_PREV()

