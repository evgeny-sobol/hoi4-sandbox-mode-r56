  focus[id = SER_form_peasant_councils]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = SER_recreate_yugoslavia]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($MAC) + $opinion_factor($CRO) + $opinion_factor($BOS) + $opinion_factor($SLV)) / 4
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($MAC)
        $rivalry_vs_into($CRO)
        $rivalry_vs_into($BOS)
        $rivalry_vs_into($SLV)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $MAC->is_friend_of_PREV()
          $CRO->is_friend_of_PREV()
          $BOS->is_friend_of_PREV()
          $SLV->is_friend_of_PREV()

