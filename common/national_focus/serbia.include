  focus[id = SER_secure_flanks]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($PREV)
      +modifier:
        $ai_rivalry_modifier($PREV)
      +modifier:
        $ai_betrayal_modifier_vs($PREV)
    available:
      $PREV->can_PREV_get_wargoal_on_THIS()

  focus[id = SER_advance_north]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($BOS) + $opinion_factor($CRO) + $opinion_factor($SLV)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($BOS)
        $rivalry_vs_into($CRO)
        $rivalry_vs_into($SLV)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $BOS->is_friend_of_PREV()
          $CRO->is_friend_of_PREV()
          $SLV->is_friend_of_PREV()

  focus[id = SER_join_axis]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = SER_militarism]:
    ai_will_do:
