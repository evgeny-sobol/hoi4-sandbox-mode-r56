focus_tree[id = german_focus]:

  focus[id = GER_prioritize_economic_growth]:
    +ai_will_do:
      modifier:
        $root_modifier()
      modifier:
        $ai_sandbox_set(40)
        or:
          has_completed_focus(GER_re_establish_free_elections_ww)
          has_completed_focus(GER_return_of_the_kaiser)
          has_completed_focus(GER_return_of_the_kaiser_ww)
      modifier:
        $ai_sandbox_set(13.33)
        or:
          has_completed_focus(GER_start_the_proletarian_revolution)
      modifier:
        factor(0)
        NOT:
          or:
            has_completed_focus(GER_re_establish_free_elections_ww)
            has_completed_focus(GER_return_of_the_kaiser)
            has_completed_focus(GER_return_of_the_kaiser_ww)
            has_completed_focus(GER_start_the_proletarian_revolution)
        is_sandbox_mode_on()

