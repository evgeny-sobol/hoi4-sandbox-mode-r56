      +modifier:
        antagonism = 1 - ($opinion_factor($SOV) + $opinion_factor($PREV)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($SOV, $PREV)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $SOV->is_friend_of_PREV()
          $PREV->is_friend_of_PREV()
