  focus[id = CHL_northern_expansion]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($BOL) + $opinion_factor($PAR) + $opinion_factor($PRU)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($BOL)
        $rivalry_vs_into($PAR)
        $rivalry_vs_into($PRU)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $BOL->is_friend_of_PREV()
          $PAR->is_friend_of_PREV()
          $PRU->is_friend_of_PREV()

