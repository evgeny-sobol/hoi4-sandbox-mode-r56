    +available:
      is_liberal_leader(no)

  focus[id = SOV_civil_war_the_free_russian_people]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = SOV_civil_war_baltic_freedom]:
    ai_will_do:
      +modifier:
