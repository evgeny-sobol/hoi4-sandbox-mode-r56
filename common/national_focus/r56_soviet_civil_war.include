  focus[id = SOV_civil_war_imperial_legacy]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = SOV_civil_war_rule_over_the_mongols]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($MON) + $opinion_factor($TAN)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($MON, $TAN)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $MON->is_friend_of_PREV()
          $TAN->is_friend_of_PREV()
    available:
      $MON->can_PREV_get_wargoal_on_THIS()
      $TAN->can_PREV_get_wargoal_on_THIS()

  focus[id = SOV_civil_war_crush_our_eastern_rival]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($MAN) + $opinion_factor($JAP)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($MAN, $JAP)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $MAN->is_friend_of_PREV()
          $JAP->is_friend_of_PREV()
    available:
      $MAN->can_PREV_get_wargoal_on_THIS()
      $JAP->can_PREV_get_wargoal_on_THIS()

  focus[id = SOV_civil_war_our_american_holding]:
