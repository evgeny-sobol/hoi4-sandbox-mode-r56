focus_tree[id = germany_shared_focus]:

  focus[id = GERK_legacy_of_the_zollverein]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = GERK_move_towards_german_reunification]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($PREV)
      +modifier:
        $ai_rivalry_modifier($PREV)
      +modifier:
        $ai_betrayal_modifier_vs($PREV)
    available:
      $PREV->can_PREV_get_wargoal_on_THIS()

  focus[id = GERK_revitalize_old_traditions]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()

  focus[id = GERK_root_militarism]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = GERK_gott_mit_uns]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = GERK_factory_of_europe]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = GERK_army_with_a_state]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = GERK_rifle_modernization]:
    ai_will_do:
