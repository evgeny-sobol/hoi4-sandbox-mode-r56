# Rt56 2026-11-08 moved these focuses out of china_nationalist_sea_focus into
# shared_focus declarations in r56_ncns_branches_shared_focus.txt. A focus that
# lives in a shared file is patched as a shared_focus, and a shared_focus is not
# reachable from inside a focus_tree (the compiler answers 'block path segment
# not found'), so the same AI-weighting splices land here.

shared_focus[id = CHI_rocaf]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()

