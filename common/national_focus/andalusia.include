focus_tree[id = andalusia_focus]:

  focus[id = ADU_assessing_our_future]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()

  focus[id = ADU_entrench_the_islamic_party]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_promote_quietism]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_listen_to_the_islamists]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_reinforce_muslim_brotherhood]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_strike_at_gibraltars_vice]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_promote_the_lesser_jihad]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_the_well_guided]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_celebrate_martyrdom]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_reconquer_our_dar_al_islam]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()

  focus[id = ADU_secure_maghreb]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($TUN) + $opinion_factor($MOR) + $opinion_factor($ALG) + $opinion_factor($LBA)) / 4
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($TUN)
        $rivalry_vs_into($MOR)
        $rivalry_vs_into($ALG)
        $rivalry_vs_into($LBA)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $TUN->is_friend_of_PREV()
          $MOR->is_friend_of_PREV()
          $ALG->is_friend_of_PREV()
          $LBA->is_friend_of_PREV()

  focus[id = ADU_war_with_france]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($FRA)
      +modifier:
        $ai_rivalry_modifier($FRA)
      +modifier:
        $ai_betrayal_modifier_vs($FRA)
    available:
      $FRA->can_PREV_get_wargoal_on_THIS()

  focus[id = ADU_lead_the_ummah]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_unite_the_maghreb]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_unite_the_opposition]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_undermine_theocracy]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADU_embrace_modernity]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

