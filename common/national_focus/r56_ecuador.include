focus_tree[id = r56_ecuadorian_focus]:

  focus[id = ECU_Alert_in_the_front]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()

  focus[id = ECU_desperate_mobilization]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ECU_gallos_plan]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = ECU_focus_on_defending_quito]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = ECU_industralize_the_amazon]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = ECU_our_true_borders]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ECU_adquire_usa_planes]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ECU_annex_the_north_of_Peru]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
