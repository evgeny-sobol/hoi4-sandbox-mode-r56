  focus[id = PAK_The_Graveyard_of_Empires]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        $ai_antagonism_modifier($AFG)
      modifier:
        $ai_rivalry_modifier($AFG)
      modifier:
        $ai_betrayal_modifier_vs($AFG)
    available:
      $AFG->can_PREV_get_wargoal_on_THIS()

  focus[id = PAK_Down_with_Persia]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        $ai_antagonism_modifier($PER)
      modifier:
        $ai_rivalry_modifier($PER)
      modifier:
        $ai_betrayal_modifier_vs($PER)
    available:
      $PER->can_PREV_get_wargoal_on_THIS()

  focus[id = PAK_Into_India]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        $ai_antagonism_modifier($RAJ)
      modifier:
        $ai_rivalry_modifier($RAJ)
      modifier:
        $ai_betrayal_modifier_vs($RAJ)
    available:
      $RAJ->can_PREV_get_wargoal_on_THIS()

  focus[id = PAK_Into_the_Steppes]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $ai_war_support_modifier()
      modifier:
        antagonism = 1 - ($opinion_factor($TMS) + $opinion_factor($UZB) + $opinion_factor($TAJ) + $opinion_factor($KYR) + $opinion_factor($KAZ)) / 5
        factor(antagonism)
        is_sandbox_mode_on()
      modifier:
        rivalry_vs = 0
        $rivalry_vs_into($TMS)
        $rivalry_vs_into($UZB)
        $rivalry_vs_into($TAJ)
        $rivalry_vs_into($KYR)
        $rivalry_vs_into($KAZ)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      modifier:
        $ai_betrayal_modifier()
        or:
          $TMS->is_friend_of_PREV()
          $UZB->is_friend_of_PREV()
          $TAJ->is_friend_of_PREV()
          $KYR->is_friend_of_PREV()
          $KAZ->is_friend_of_PREV()

