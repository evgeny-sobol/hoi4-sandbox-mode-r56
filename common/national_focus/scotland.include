  focus[id = SCO_celtic_liberation]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($NIR) + $opinion_factor($PREV) + $opinion_factor($IRE) + $opinion_factor($WLS)) / 4
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($NIR)
        $rivalry_vs_into($PREV)
        $rivalry_vs_into($IRE)
        $rivalry_vs_into($WLS)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $NIR->is_friend_of_PREV()
          $PREV->is_friend_of_PREV()
          $IRE->is_friend_of_PREV()
          $WLS->is_friend_of_PREV()

  focus[id = SCO_push_for_brittany]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($BRI) + $opinion_factor($PREV)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($BRI, $PREV)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $BRI->is_friend_of_PREV()
          $PREV->is_friend_of_PREV()
    available:
      $BRI->can_PREV_get_wargoal_on_THIS()
      $PREV->can_PREV_get_wargoal_on_THIS()

