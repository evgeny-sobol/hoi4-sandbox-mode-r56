      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($BAY)
      +modifier:
        $ai_rivalry_modifier($BAY)
      +modifier:
        $ai_betrayal_modifier_vs($BAY)
    available:
      $BAY->can_PREV_get_wargoal_on_THIS()

