  focus[id = TUR_dominate_the_arabian_peninsula]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($SAU) + $opinion_factor($YEM)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($SAU, $YEM)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $SAU->is_friend_of_PREV()
          $YEM->is_friend_of_PREV()
    available:
      $SAU->can_PREV_get_wargoal_on_THIS()
      $YEM->can_PREV_get_wargoal_on_THIS()

