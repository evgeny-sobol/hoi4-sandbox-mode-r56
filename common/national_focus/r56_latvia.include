    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($EST)
      +modifier:
        $ai_rivalry_modifier($EST)
      +modifier:
        $ai_betrayal_modifier_vs($EST)
    available:
      $EST->can_PREV_get_wargoal_on_THIS()

  focus[id = LAT_liberate_lithuania]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($LIT)
      +modifier:
        $ai_rivalry_modifier($LIT)
      +modifier:
        $ai_betrayal_modifier_vs($LIT)
    available:
      $LIT->can_PREV_get_wargoal_on_THIS()

