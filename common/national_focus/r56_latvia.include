  focus[id = LAT_baltics_under_one_flag]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($EST) + $opinion_factor($LIT)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($EST, $LIT)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $EST->is_friend_of_PREV()
          $LIT->is_friend_of_PREV()
    available:
      $EST->can_PREV_get_wargoal_on_THIS()
      $LIT->can_PREV_get_wargoal_on_THIS()

  focus[id = LAT_privatize_the_industry]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = LAT_hail_the_struggle]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
