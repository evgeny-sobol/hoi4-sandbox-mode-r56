      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_cooperation_modifier($USA)
      +modifier:
        factor(0)
        $USA in rivals[]
        is_sandbox_mode_on()
    +available:
      $not_rival_of_PREV($USA)

