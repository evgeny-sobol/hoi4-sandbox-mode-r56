        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($DOM) + $opinion_factor($HAI)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($DOM, $HAI)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $DOM->is_friend_of_PREV()
          $HAI->is_friend_of_PREV()
