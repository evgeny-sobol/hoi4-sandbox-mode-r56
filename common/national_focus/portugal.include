focus_tree[id = portuguese_focus]:

  focus[id = POR_colonial_assimilation_policy]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()

  focus[id = POR_colonial_army]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()

  focus[id = POR_luso_tropicalism]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        f = 1 + mtth:fascism_factor
        factor(f)
        is_sandbox_mode_on()

  focus[id = POR_limited_self_rule]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($ANG) + $opinion_factor($MZB) + $opinion_factor($POR)) / 3
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        rivalry_vs = 0
        $rivalry_vs_into($ANG)
        $rivalry_vs_into($MZB)
        $rivalry_vs_into($POR)
        f = 1 + rivalry_vs / 50
        factor(f)
        is_sandbox_mode_on()
      +modifier:
        $ai_betrayal_modifier()
        or:
          $ANG->is_friend_of_PREV()
          $MZB->is_friend_of_PREV()
          $POR->is_friend_of_PREV()
    available:
      $ANG->can_PREV_get_wargoal_on_THIS()
      $MZB->can_PREV_get_wargoal_on_THIS()
      $POR->can_PREV_get_wargoal_on_THIS()

  focus[id = POR_haven_of_neutrality_macau]:
