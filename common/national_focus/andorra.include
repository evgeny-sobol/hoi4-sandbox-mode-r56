focus_tree[id = andorra_focus]:

  focus[id = ADR_continue_the_policy_of_neutrality]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()

  focus[id = ADR_accept_spanish_refugees]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADR_normalize_spanish_relations]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADR_expand_the_tourist_industry]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = ADR_encourage_foreign_investment]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = ADR_abandon_the_policy_of_neutrality]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()

  focus[id = ADR_accept_french_potectorate]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = ADR_a_flexible_foreign_policy]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
