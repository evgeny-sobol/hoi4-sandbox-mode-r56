  focus[id = VEN_attack_south_south_america]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($CHL) + $opinion_factor($ARG)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($CHL, $ARG)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $CHL->is_friend_of_PREV()
          $ARG->is_friend_of_PREV()
    available:
      $CHL->can_PREV_get_wargoal_on_THIS()
      $ARG->can_PREV_get_wargoal_on_THIS()

