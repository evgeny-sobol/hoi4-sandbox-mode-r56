      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($SIK) + $opinion_factor($KHM)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($SIK, $KHM)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $SIK->is_friend_of_PREV()
          $KHM->is_friend_of_PREV()
    +available:
      $SIK->can_PREV_get_wargoal_on_THIS()
      $KHM->can_PREV_get_wargoal_on_THIS()

