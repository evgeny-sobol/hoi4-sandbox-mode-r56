  focus[id = MAL_worldstage]:
    +ai_will_do:
      modifier:
        $ai_sandbox_modifier()
      modifier:
        $root_modifier()

  focus[id = MAL_worldstage_1]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = MAL_worldstage_2]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($PHI)
      +modifier:
        $ai_rivalry_modifier($PHI)
      +modifier:
        $ai_betrayal_modifier_vs($PHI)
    available:
      $PHI->can_PREV_get_wargoal_on_THIS()

  focus[id = MAL_worldstage_3]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = MAL_worldstage_4]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        antagonism = 1 - ($opinion_factor($SIA) + $opinion_factor($INS)) / 2
        factor(antagonism)
        is_sandbox_mode_on()
      +modifier:
        $ai_rivalry_modifier_max($SIA, $INS)
      +modifier:
        $ai_betrayal_modifier()
        or:
          $SIA->is_friend_of_PREV()
          $INS->is_friend_of_PREV()
    available:
      $SIA->can_PREV_get_wargoal_on_THIS()
      $INS->can_PREV_get_wargoal_on_THIS()

  focus[id = MAL_worldstage_5]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = MAL_worldstage_6]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = MAL_worldstage_7]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
