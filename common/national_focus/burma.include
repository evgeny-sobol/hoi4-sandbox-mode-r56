focus_tree[id = burma_focus]:

  focus[id = BRM_preserve_burma]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)

  focus[id = BRM_fortification_effort]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = BRM_fortify_the_indian_border]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = BRM_fortify_the_chinese_border]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = BRM_fortify_shanland]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $ai_mic_modifier()

  focus[id = BRM_unite_the_burmese_people]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
      +modifier:
        $root_modifier()
      +modifier:
        $crossroad_modifier(2)
      +modifier:
        $ai_war_support_modifier()
      +modifier:
        $ai_antagonism_modifier($PREV)
      +modifier:
        $ai_rivalry_modifier($PREV)
      +modifier:
        $ai_betrayal_modifier_vs($PREV)
    available:
      $PREV->can_PREV_get_wargoal_on_THIS()

  focus[id = BRM_seize_colonial_stockpiles]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = BRM_national_defence_corps]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = BRM_defence_services_academy]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = BRM_equipment_modernization]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = BRM_motorization_of_the_army]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = BRM_the_metal_peacock]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = BRM_railway_artillery]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = BRM_national_defence_state]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()

  focus[id = BRM_masters_of_the_ecoregion_jungle]:
    ai_will_do:
      +modifier:
        $ai_sandbox_modifier()
