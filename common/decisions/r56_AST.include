# Pattern D: AST lights a war in INS / MAL (gdd/Civil Wars.md gate the actor).
# Do not +trigger the events: a player AST at cap must still start them.
operations:
  start_indonesian_uprising:
    ai_will_do:
      +modifier:
        $ai_civil_war_decision_cap()
  start_malayan_uprising:
    ai_will_do:
      +modifier:
        $ai_civil_war_decision_cap()
