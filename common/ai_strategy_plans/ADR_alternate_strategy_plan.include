ADR_neutrality_spanish_guarantee:
  enable:
    is_sandbox_mode_on(no)
  +abort:
    is_sandbox_mode_on(yes)

ADR_flexible_foreign_policy:
  enable:
    is_sandbox_mode_on(no)
  +abort:
    is_sandbox_mode_on(yes)

ADR_french_protectorate:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)
