CAN_democratic_alternative_plan_R56:
  enable:
    is_sandbox_mode_on(no)
  +abort:
    is_sandbox_mode_on(yes)

CAN_communist_plan_R56:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)

CAN_fascist_plan_R56:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)
