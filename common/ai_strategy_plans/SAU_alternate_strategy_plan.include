SAU_democratic_plan:
  enable:
    is_sandbox_mode_on(no)
  +abort:
    is_sandbox_mode_on(yes)

SAU_communist_plan:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)

SAU_fascist_plan:
  enable:
    is_sandbox_mode_on(no)
  abort:
    OR:
      is_sandbox_mode_on(yes)
