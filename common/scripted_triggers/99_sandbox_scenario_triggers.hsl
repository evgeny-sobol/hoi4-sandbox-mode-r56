# docs/gdd/Scenarios.md "Selection": pin-rule options for the scenario pick.
# has_game_rule needs a verbatim two-key block, hence raw inline.
sandbox_scenario_pin_is_nazi_germany:
  raw has_game_rule: { rule = sandbox_scenario option = sandbox_nazi_germany }
sandbox_scenario_pin_is_fascist_italy:
  raw has_game_rule: { rule = sandbox_scenario option = fascist_italy }
sandbox_scenario_pin_is_militarist_japan:
  raw has_game_rule: { rule = sandbox_scenario option = militarist_japan }
sandbox_scenario_pin_is_soviet_west:
  raw has_game_rule: { rule = sandbox_scenario option = soviet_west }
sandbox_scenario_pin_is_napoleonic_france:
  raw has_game_rule: { rule = sandbox_scenario option = napoleonic_france }
sandbox_scenario_pin_is_monarchical_great_britain:
  raw has_game_rule: { rule = sandbox_scenario option = monarchical_great_britain }

# AFG BoP total-control range that starts a fascist war inline. Rt56-only:
# vanilla common/bop/ has no AFG. Consumed by sandbox_retry_afg_bop_civil_war_fuse
# in common/scripted_effects/99_sandbox_scenarios.hsl.
sandbox_afg_bop_cw_fuse_ready:
  $is_power_balance_in_range(AFG_power_balance, AFG_total_government_influence)
  not has_government(fascism)
  not has_country_flag(AFG_had_civil_war_bop)
  not has_civil_war()
  not has_war()
